<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      CA根认证中心（csssl）多模块父工程：
      - csssl-push-sdk：对外推送 SDK（DTP + SM2 验签工具），供 HIS 等外部系统依赖
      - csssl-server：Spring Boot 启动模块（证书服务、审批流、管理后台 API）
    -->
    <groupId>com.csssl</groupId>
    <artifactId>csssl-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>csssl-parent</name>
    <description>CA根认证中心（csssl）多模块父工程</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <hutool.version>5.8.26</hutool.version>
        <jjwt.version>0.12.5</jjwt.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
    </properties>

    <modules>
        <module>csssl-server</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
