<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.csssl</groupId>
        <artifactId>csssl-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>csssl-web</artifactId>
    <packaging>jar</packaging>
    <name>csssl-web</name>
    <description>Spring Boot 启动模块：只放启动类与 config（装配、安全过滤），全工程唯一产出可执行 jar 的模块；controller 全部下沉到所属业务模块。</description>

    <dependencies>
        <dependency>
            <groupId>com.csssl</groupId>
            <artifactId>csssl-ca</artifactId>
        </dependency>
        <dependency>
            <groupId>com.csssl</groupId>
            <artifactId>csssl-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.csssl</groupId>
            <artifactId>csssl-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.csssl</groupId>
            <artifactId>csssl-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.csssl</groupId>
            <artifactId>csssl-sdk</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>csssl-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.csssl.CssslApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <!-- repackage 的单次绑定由 spring-boot-starter-parent 的 pluginManagement 提供，
                     此处再写 execution 会让 jar 被 repackage 两遍（第二次把第一次的产物改名成 .original）。 -->
            </plugin>
        </plugins>
    </build>
</project>
