# 复制成同目录 .env 后填真值（.env 已在 .gitignore 里排除，禁止入库）。
# compose 的 env_file 把它整份注入 csssl-backend 容器，application-pro.yml 里对应项只有 ${SSL_*:} 占位。
# 本清单与 pro 文件引用的变量逐字对齐；不填即空串，被对应能力按「未配置」失败关闭。

SPRING_PROFILES_ACTIVE=pro

# 连接串里的 host 用 host.docker.internal：MySQL 是宿主机进程，不是容器
SSL_DB_URL=jdbc:mysql://host.docker.internal:3306/ssl_ca?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SSL_DB_USERNAME=
SSL_DB_PASSWORD=

# 对外公开基础地址：生成证书的 CDP/AIA/OCSP URL 用（各业务系统要能访问到）；
# 不填则回落 pro 文件里的 localhost 默认值（只够本机联调）
SSL_PUBLIC_BASE_URL=http://192.168.88.132:8012/ssl

# 私钥加密主密钥（32位十六进制）。不填则首启随机生成落盘 data/certs/master.key（compose 已把 ./data 挂出来，重启不丢）
# SSL_MASTER_KEY=


# JWT 签名密钥（生产必须覆盖；不填则 token 签发/校验不可用）
SSL_JWT_SECRET=

# 生产默认关闭私钥下载（application-pro.yml 默认 false）；需要时显式打开
# SSL_ALLOW_KEY_DOWNLOAD=true
